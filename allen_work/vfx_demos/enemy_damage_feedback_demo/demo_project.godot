; Engine configuration file.
; Keep this demo small so it can be opened alone in Godot.

config_version=5

[application]

config/name="Enemy Damage Feedback Demo"
run/main_scene="res://scenes/enemy_damage_feedback_demo.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
